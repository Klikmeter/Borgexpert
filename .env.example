# Railway: zet deze als Variables op de service. Lokaal: kopieer naar .env en start met `node --env-file=.env src/server.js`.

# Postgres. Op Railway: Variables > Add Variable Reference > Postgres > DATABASE_URL (interne URL, geen TLS nodig).
DATABASE_URL=

# Resend. API key uit https://resend.com/api-keys. Zonder key worden aanvragen wel opgeslagen maar nog niet gemaild;
# ze gaan alsnog weg zodra de key gezet is.
RESEND_API_KEY=
# Afzender: het domein moet in Resend geverifieerd zijn (borgexpert.online).
EMAIL_FROM=Borg Expert <aanvraag@borgexpert.online>
# Waar de aanvragen naartoe gaan. Meerdere adressen mag, gescheiden door komma's.
EMAIL_TO=info@borgexpert.nl
# Optioneel: blinde kopie van elke aanvraagmail, bijvoorbeeld om te controleren of alles aankomt.
# EMAIL_BCC=
# Bevestigingsmail aan de aanvrager (true/false).
CONFIRMATION_EMAIL=true

# Publieke URL, zonder slash aan het eind. Wordt gebruikt voor de origin-check en in de mail.
APP_URL=https://www.borgexpert.online
# Stuur andere hostnamen (bijv. het *.up.railway.app-adres) door naar APP_URL. Pas aanzetten als het domein werkt.
CANONICAL_REDIRECT=false

# Google Analytics 4. Met deze waarde komt de Google-tag op de pagina, plus een cookiebalk (Consent Mode).
# Het event 'generate_lead' gaat af bij een geslaagde aanvraag; markeer het in GA4 als belangrijke gebeurtenis en importeer het in Google Ads.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Turnstile (gratis botcontrole): https://dash.cloudflare.com > Turnstile > Add widget, domein www.borgexpert.online.
# Beide leeg = geen Turnstile; dan beschermen alleen honeypot en rate limit.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optioneel
# PORT=8080
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MINUTES=15
# MAIL_RETRY_INTERVAL_MINUTES=5
